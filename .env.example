# Optional server-side GitHub token for higher API limits.
# Never prefix this variable with NEXT_PUBLIC_ or expose it to browser code.
GITHUB_RADAR_TOKEN=

# Optional FreeLLMAPI-powered Radar query planning.
# Local FreeLLMAPI defaults to http://127.0.0.1:3001/v1.
# A hosted Bitcase deployment requires a publicly reachable HTTPS /v1 endpoint.
BITCASE_AI_PROVIDER=freellmapi
BITCASE_AI_BASE_URL=http://127.0.0.1:3001/v1
BITCASE_AI_MODEL=kimi-k2.6
BITCASE_AI_DAILY_LIMIT=3
FREELLMAPI_API_KEY=

# Optional owner email for the private aggregate analytics route.
BITCASE_OWNER_EMAIL=
