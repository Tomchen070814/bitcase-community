# Optional server-side GitHub token for higher API limits.
# Never prefix this variable with NEXT_PUBLIC_ or expose it to browser code.
GITHUB_RADAR_TOKEN=

# Production: direct Cloudflare Workers AI-powered Radar query planning.
BITCASE_AI_PROVIDER=cloudflare
BITCASE_AI_MODEL=@cf/moonshotai/kimi-k2.6
BITCASE_AI_DAILY_LIMIT=3
BITCASE_AI_GLOBAL_DAILY_LIMIT=100
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Local development alternative using FreeLLMAPI:
# BITCASE_AI_PROVIDER=freellmapi
# BITCASE_AI_BASE_URL=http://127.0.0.1:3001/v1
# BITCASE_AI_MODEL=kimi-k2.6
FREELLMAPI_API_KEY=

# Optional owner email for the private aggregate analytics route.
BITCASE_OWNER_EMAIL=
